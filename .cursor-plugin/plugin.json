{
  "name": "ihateposting",
  "displayName": "iHatePosting",
  "version": "0.3.1",
  "description": "Draft, check and schedule posts to 14 social networks from Cursor. Every post is a draft until you say otherwise.",
  "author": {
    "name": "iHatePosting"
  },
  "homepage": "https://ihateposting.com/guides/post-to-social-media-from-an-ai-agent",
  "repository": "https://github.com/iHatePostingOrg/agent-skill",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "ihateposting",
    "social-media",
    "scheduler",
    "social-media-scheduler",
    "mcp",
    "mcp-server",
    "bluesky",
    "x",
    "linkedin",
    "facebook",
    "threads",
    "mastodon",
    "telegram",
    "discord",
    "tumblr",
    "slack",
    "instagram",
    "pinterest",
    "tiktok",
    "youtube"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "IHATEPOSTING_API_KEY": {
        "type": "string",
        "title": "iHatePosting API key",
        "description": "Starts with pk_live_. Create one at ihateposting.com under Settings, Developers."
      }
    },
    "required": [
      "IHATEPOSTING_API_KEY"
    ]
  },
  "mcpServers": "./mcp.cursor.json"
}
